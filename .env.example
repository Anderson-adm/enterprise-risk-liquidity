# Copy to .env (git-ignored) and adjust. Never commit real credentials.

# local | aws
ERL_MODE=local
# sqlite (no container runtime) | containers (docker/compose.yaml)
ERL_SOURCE_BACKEND=sqlite
ERL_DATA_DIR=data

# --- containers backend (local development passwords only) ---
# ERL_PG_PASSWORD=change-me-local-only
# ERL_MSSQL_SA_PASSWORD=Change-me-local-0nly!

# --- aws (hybrid) mode: values come from `terraform output` ---
# AWS_PROFILE=erl-dev-runner          # SSO profile that assumes the runner role
# ERL_AWS_ACCOUNT_ID=<data-dev account id>
# ERL_AWS_REGION=sa-east-1
# ERL_S3_BUCKET=
# ERL_ATHENA_WORKGROUP=erl-dev
# ERL_ATHENA_RESULTS_S3=
# ERL_LAKEHOUSE_S3=
# ERL_GLUE_DB_PREFIX=erl_dev
# ERL_ALERTS_TOPIC_ARN=
