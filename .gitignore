# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
# generated artifacts (scripts/build/build_artifacts.py); anchored so scripts/build/ is versioned
/dist/
/build/

# Local runtime data (regenerated by `erl generate` / pipeline runs)
data/*
!data/.gitkeep
evidence/raw/

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml

# Airflow local home
.airflow/

# Terraform: never version state, plans or provider caches
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
tfplan*
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.tfvars
*.tfvars.json
backend.hcl
plan.out
*.plan
*.plan.json
tfplan.json
plan.json

# Local tooling binaries (tflint etc.)
.tools/

# Secrets / local env
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.aws/

# Terraform plan exports
*.plan.txt
